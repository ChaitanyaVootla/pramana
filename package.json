{
  "name": "pramana",
  "private": true,
  "version": "0.1.0",
  "description": "Evidence-first, citation-backed learning platform for history. Claims, excerpts and arguments as structured data.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @pramana/db generate",
    "db:migrate": "pnpm --filter @pramana/db migrate",
    "dev": "pnpm --filter @pramana/web dev",
    "build": "pnpm --filter @pramana/web build",
    "mcp": "pnpm --filter @pramana/mcp start",
    "seed": "tsx scripts/seed/index.ts",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "screenshot": "tsx scripts/screenshot.ts",
    "check:atlas": "tsx scripts/check-atlas.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pramana/connectors": "workspace:*",
    "@pramana/core": "workspace:*",
    "@pramana/db": "workspace:*",
    "@pramana/services": "workspace:*",
    "@types/node": "^22.15.0",
    "drizzle-orm": "^0.45.4",
    "playwright": "^1.64.1",
    "prettier": "^3.6.0",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.0",
    "zod": "^4.6.7"
  }
}
