{
  "name": "@pramana/mcp",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "MCP server: read, question, cite and propose changes to Pramana from any MCP client (e.g. Claude Code).",
  "exports": {
