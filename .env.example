# Postgres (see docker-compose.yml). Bound to localhost only.
DATABASE_URL=postgres://pramana:pramana@127.0.0.1:5442/pramana

# Where captured source texts (snapshots) and the HTTP cache live.
PRAMANA_DATA_DIR=./data

# The human this local instance acts for. There is NO authentication in the MVP:
# never expose the web app or MCP server beyond localhost.
PRAMANA_USER_HANDLE=me
PRAMANA_USER_NAME=Me

# Identity recorded for MCP tool calls (the agent acting on the user's behalf).
PRAMANA_AGENT_HANDLE=claude-code

# Optional contact appended to the HTTP User-Agent for Wikimedia/Internet Archive
# (Wikimedia asks API clients to identify themselves). Leave empty to omit.
PRAMANA_HTTP_CONTACT=

# Base URL of the web app, used in links returned by MCP tools.
PRAMANA_WEB_URL=http://localhost:3000
