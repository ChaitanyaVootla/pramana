    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pramana/connectors": "workspace:*",
    "@pramana/core": "workspace:*",
    "@pramana/db": "workspace:*",
    "@pramana/services": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
